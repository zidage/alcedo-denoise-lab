# Temporary build files only: virtual environments, logs, caches. Safe to delete at any time.
build/

# Datasets and training patches. Only the folder README is committed.
data/*
!data/README.md

# Model weights, checkpoints, and exported graphs. Only the folder README is committed.
models/*
!models/README.md

# Results: the text results (JSON, tables, Markdown) are committed. Images and binary arrays of a
# result stay on the local machine.
results/**/images/
results/**/*.npz
results/**/*.npy

# Photos and images made from photos, in any folder. The evaluation photos must not be shared.
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.exr
*.dng
*.arw
*.nef
*.cr2
*.cr3
*.raf

# Weight and graph files, in any folder.
*.onnx
*.onnx.data
*.pt
*.pth
*.safetensors
*.mlpackage/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Agent tool local state
.uv-cache/
.uv-python/
.scratch/
skills-lock.json
.claude/
.codex/
